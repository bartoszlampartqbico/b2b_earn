# Skopiuj do .env (plik jest w .gitignore) i uzupełnij.

# Supabase: Project Settings -> Database -> Connection string (URI).
# Hasło do bazy, NIE klucz anon/service_role.
DATABASE_URL=postgresql://postgres:HASLO@db.xxxxxxxx.supabase.co:5432/postgres
# DATABASE_SSL=false   # tylko dla lokalnego Postgresa bez TLS

# Klucz do podpisywania sesji, min. 32 znaki. Wygeneruj:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

PORT=3001
# NODE_ENV=production  # na serwerze: serwuje dist/ i ustawia cookie jako Secure (wymaga HTTPS)
# TRUST_PROXY=1        # gdy aplikacja stoi za reverse proxy
